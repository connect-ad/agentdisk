# Copy to .env and fill in. .env is gitignored — it holds a live credential.

# The deployment under test. Point this at the preview Worker to test a branch.
BASE_URL=https://app-dev.agentdisk.io

# The API the dashboard talks to. Used by the security specs, which call it
# directly to assert the shape of an unauthenticated failure.
API_BASE=https://api-dev.agentdisk.io

# The dev test account. `npm run login` signs in with these, creating the
# account through the real signup UI if it does not exist yet.
TEST_EMAIL=
TEST_PASSWORD=
