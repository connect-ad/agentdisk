# Copy to backend.hcl and fill in, or let CI generate it from repository
# variables. backend.hcl is git-ignored: it names your account.
#
#   terraform init -backend-config=backend.hcl
#
# Credentials are NOT set here. Terraform reads the R2 S3 token from the
# environment: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, populated in CI from
# the R2_STATE_ACCESS_KEY_ID / R2_STATE_SECRET_ACCESS_KEY repository secrets.

bucket = "agentdisk-tfstate"

endpoints = {
  s3 = "https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com"
}
